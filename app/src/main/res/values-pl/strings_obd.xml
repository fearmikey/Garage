    <!-- OBD2 scanner: errors -->
    <string name="obd_error_connect_wifi">Nie można połączyć się z adapterem Wi-Fi pod adresem %1$s. Upewnij się, że telefon jest połączony z siecią Wi-Fi adaptera.</string>
    <string name="obd_error_connect_ble">Nie można połączyć się z adapterem Bluetooth LE. Upewnij się, że jest podłączony, zapłon jest włączony i nie jest połączony z innym telefonem.</string>
    <string name="obd_error_connect_classic">Nie można połączyć się z adapterem. Upewnij się, że Bluetooth jest włączony, adapter jest podłączony, zapłon jest włączony i adapter jest w zasięgu.</string>
    <string name="obd_error_timeout">Adapter przestał odpowiadać. Sprawdź, czy ma zasilanie i czy zapłon jest włączony.</string>
    <string name="obd_error_lost_connection">Utracono połączenie z adapterem.</string>
    <string name="obd_error_generic">Błąd komunikacji z adapterem OBD: %1$s</string>
    <string name="obd_error_clear_not_confirmed">Pojazd nie potwierdził kasowania. Wyłącz silnik (z włączonym zapłonem) i spróbuj ponownie.</string>
    <string name="obd_error_clear_no_response">Adapter nie odpowiedział na żądanie kasowania.</string>
    <string name="obd_error_no_live_pids">Ten pojazd nie udostępnia danych na żywo.</string>
    <string name="obd_error_unable_to_connect">Adapter nie mógł połączyć się z pojazdem. Czy zapłon jest włączony?</string>
    <string name="obd_error_can_bus">Błąd magistrali CAN. Sprawdź, czy adapter jest dobrze osadzony w gnieździe OBD2.</string>
    <string name="obd_error_vehicle_bus">Błąd magistrali pojazdu. Sprawdź, czy adapter jest dobrze osadzony w gnieździe OBD2.</string>
    <string name="obd_error_bus_feedback">Błąd sprzężenia zwrotnego magistrali pojazdu. Sprawdź połączenie adaptera.</string>
    <string name="obd_error_low_voltage">Adapter zresetował się z powodu niskiego napięcia. Sprawdź akumulator pojazdu.</string>
    <string name="obd_error_bus_init">Adapter zgłosił błąd inicjalizacji magistrali. Czy zapłon jest włączony?</string>
    <string name="obd_error_internal">Adapter zgłosił błąd wewnętrzny %1$s.</string>

