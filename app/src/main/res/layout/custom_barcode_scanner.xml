<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the activity's content FrameLayout, so children use layout_gravity directly. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_preview_scaling_strategy="centerCrop"
        app:zxing_use_texture_view="false" />

    <!-- Top controls (top margin is adjusted for the status bar in CustomScannerActivity) -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="20dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_scanner_round_button"
        android:contentDescription="@string/cd_go_back"
        android:elevation="4dp"
        android:scaleType="center"
        android:src="@drawable/ic_arrow_back"
        android:tint="#FFFFFF" />

    <ImageButton
        android:id="@+id/btn_torch"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_scanner_round_button"
        android:contentDescription="@string/cd_toggle_flashlight"
        android:elevation="4dp"
        android:scaleType="center"
        android:src="@drawable/ic_flashlight"
        android:tint="#FFFFFF" />

    <!-- Instruction label + shutter button, stacked at the bottom -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_instruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_instruction_chip"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/scan_vin_instruction"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btn_shutter"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_shutter_button"
            android:clickable="true"
            android:contentDescription="@string/cd_scan_vin"
            android:focusable="true" />
    </LinearLayout>

</merge>
